// ==========================================================
// SISTEMA DE TRIAGEM INTELIGENTE DE CURRÍCULOS — MVP
// Banco de dados: PostgreSQL (Neon)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------
// VAGA
// ----------------------------------------------------------
model Vaga {
  id          String   @id @default(cuid())
  titulo      String
  area        String?
  departamento String?
  gestorResponsavel String?
  localidade  String?
  modalidade  String?      // presencial / híbrido / remoto
  tipoContratacao String?  // CLT / PJ / temporário
  faixaSalarial String?
  escolaridadeMinima String?
  experienciaMinima String?
  descricaoCargo String    @db.Text  // texto colado pelo RH
  status      String   @default("triagem") // triagem, pausada, encerrada

  // resultado da interpretação da IA (JSON)
  matrizCompetencias Json?   // requisitos + pesos sugeridos pela IA
  pesosAprovados     Json?   // pesos finais aprovados/editados pelo RH
  jobDescriptionScore Json?  // avaliação da qualidade da vaga

  candidatos  Candidato[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// ----------------------------------------------------------
// CANDIDATO (currículo importado para uma vaga)
// ----------------------------------------------------------
model Candidato {
  id          String   @id @default(cuid())
  vagaId      String
  vaga        Vaga     @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  nomeArquivo String
  textoBruto  String   @db.Text   // texto extraído do PDF/DOCX

  // dados extraídos pela IA (JSON estruturado — ver lib/types.ts)
  dadosExtraidos Json?
  analise        Json?   // scores, evidências, gaps, pontos fortes, trajetória
  perguntasEntrevista Json?

  scoreGeral      Float?
  status          String  @default("pendente") // pendente, analisado, erro

  // controle humano (seção 37 do spec: humano no controle)
  observacoesRH   String? @db.Text
  statusRH        String? // recomendar, avaliar, nao_priorizar (pode ser sobrescrito pelo RH)

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([vagaId])
}
